---
import '../styles/global.css';
import { profileConfig } from '../config/profile';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = profileConfig.meta.title, 
  description = profileConfig.meta.description 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={profileConfig.meta.themeColor} />

    {/* SEO Meta */}
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Open Graph / Facebook / Discord Embed */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={profileConfig.meta.siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={profileConfig.profile.avatarUrl} />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={profileConfig.profile.avatarUrl} />

    {/* Anti-FOUC Theme Initialization Script */}
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('catree-theme');
          if (stored === 'light') {
            document.documentElement.classList.remove('dark');
          } else if (stored === 'dark') {
            document.documentElement.classList.add('dark');
          } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
            document.documentElement.classList.remove('dark');
          } else {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="bg-[#f6f8fa] dark:bg-[#090a0f] text-gray-900 dark:text-gray-100 min-h-screen transition-colors duration-200 antialiased font-sans flex flex-col items-center py-6 sm:py-10 px-4 sm:px-6 relative overflow-x-hidden">
    {/* Subtle ambient light to illuminate the frosted glass surfaces */}
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[600px] h-[280px] bg-blurple/10 dark:bg-blurple/15 blur-[120px] rounded-full pointer-events-none -z-10" aria-hidden="true"></div>

    <main class="w-full max-w-xl flex flex-col gap-5">
      <slot />
    </main>
  </body>
</html>
