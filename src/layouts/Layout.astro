---
import '../styles/global.css';
import { profileConfig } from '../config/profile';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = profileConfig.meta.title, 
  description = profileConfig.meta.description 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#090a0f" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f8fa" />

    {/* SEO Meta */}
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Open Graph / Facebook / Discord Embed */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={profileConfig.meta.siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={profileConfig.profile.avatarUrl} />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={profileConfig.profile.avatarUrl} />

    {/* Resource Hints */}
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />

    {/* Preload Critical LCP Banner Image */}
    {profileConfig.profile.bannerImageUrl && (
      <link 
        rel="preload" 
        as="image" 
        href={profileConfig.profile.bannerImageUrl} 
        fetchpriority="high" 
      />
    )}

    {/* Anti-FOUC Theme Initialization Script */}
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('catree-theme');
          if (stored === 'light') {
            document.documentElement.classList.remove('dark');
          } else if (stored === 'dark') {
            document.documentElement.classList.add('dark');
          } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
            document.documentElement.classList.remove('dark');
          } else {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="bg-surface-light dark:bg-obsidian text-gray-900 dark:text-gray-100 min-h-screen transition-colors duration-200 antialiased font-sans flex flex-col items-center py-6 sm:py-10 px-4 sm:px-6 relative overflow-x-hidden">
    {/* Skip to Main Content Link for Keyboard / Assistive Navigation */}
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:rounded-xl focus:bg-blurple focus:text-white focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-white text-xs font-semibold"
    >
      Skip to content
    </a>

    {/* Subtle ambient light to illuminate the frosted glass surfaces (zero-blur radial gradient) */}
    <div 
      class="fixed top-0 left-1/2 -translate-x-1/2 w-full max-w-2xl h-72 pointer-events-none -z-10 opacity-70 dark:opacity-85" 
      style="background: radial-gradient(ellipse 70% 60% at 50% 0%, rgba(88, 101, 242, 0.16) 0%, rgba(88, 101, 242, 0) 100%);"
      aria-hidden="true"
    ></div>

    <div class="w-full max-w-xl flex flex-col gap-5">
      <slot />
    </div>
  </body>
</html>
