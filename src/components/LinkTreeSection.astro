---
import type { LinkGroup } from '../config/profile';
import Icons from './Icons.astro';

interface Props {
  groups: LinkGroup[];
}

const { groups = [] } = Astro.props;
---

<div class="w-full space-y-6" aria-label="Link categories">
  {groups.map((group) => (
    <section class="space-y-3" aria-labelledby={`group-heading-${group.id}`}>
      <div class="px-1">
        <h2 
          id={`group-heading-${group.id}`}
          class="text-xs font-semibold tracking-wider uppercase text-gray-500 dark:text-gray-400"
        >
          {group.title}
        </h2>
      </div>

      <ul role="list" class="flex flex-col gap-2.5 list-none p-0 m-0">
        {group.links.map((link) => (
          <li class="w-full">
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${link.title}${link.description ? `: ${link.description}` : ''} (opens in new tab)`}
              class={`group relative flex items-center justify-between p-4 min-h-[56px] rounded-xl bg-white/70 dark:bg-obsidian-card/60 backdrop-blur-xl hover:bg-white/90 dark:hover:bg-obsidian-hover/75 active:scale-[0.985] active:bg-white/95 dark:active:bg-obsidian-hover/90 border transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blurple shadow-sm ${
                link.highlight 
                  ? 'border-blurple/50 dark:border-blurple/60 ring-1 ring-blurple/30 shadow-md shadow-blurple/5 hover:border-blurple dark:hover:border-blurple-light' 
                  : 'border-black/[0.06] dark:border-white/[0.08] hover:border-black/[0.12] dark:hover:border-white/[0.18]'
              }`}
            >
              <div class="flex items-center gap-3.5 min-w-0">
                {/* Link Icon */}
                {link.icon && (
                  <div class={`w-9 h-9 rounded-lg flex items-center justify-center shrink-0 transition-colors ${
                    link.highlight 
                      ? 'bg-blurple text-white shadow-sm shadow-blurple/30' 
                      : 'bg-black/[0.04] dark:bg-white/[0.05] border border-black/[0.04] dark:border-white/[0.05] text-gray-700 dark:text-gray-200 group-hover:text-blurple dark:group-hover:text-blurple-light'
                  }`}>
                    <Icons name={link.icon} class="w-4 h-4" />
                  </div>
                )}

                {/* Title */}
                <div class="min-w-0">
                  <span class="text-sm font-semibold text-gray-900 dark:text-white group-hover:text-blurple dark:group-hover:text-blurple-light transition-colors">
                    {link.title}
                  </span>
                  {link.description && (
                    <p class="text-xs text-gray-500 dark:text-gray-400 truncate mt-0.5">
                      {link.description}
                    </p>
                  )}
                </div>
              </div>

              {/* Action Arrow */}
              <div class="text-gray-400 dark:text-gray-500 group-hover:text-blurple dark:group-hover:text-blurple-light group-hover:translate-x-0.5 transition-all shrink-0 pl-3">
                <Icons name="external-link" class="w-4 h-4" />
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
