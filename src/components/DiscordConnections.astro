---
import type { ConnectionItem } from '../config/profile';
import Icons from './Icons.astro';

interface Props {
  connections: ConnectionItem[];
}

const { connections = [] } = Astro.props;
---

<section class="w-full space-y-3" aria-labelledby="connections-heading">
  <div class="flex items-center justify-between px-1">
    <h2 
      id="connections-heading" 
      class="text-xs font-semibold tracking-wider uppercase text-gray-500 dark:text-gray-400"
    >
      Connected Accounts
    </h2>
    <span class="text-xs text-gray-400 dark:text-gray-500 font-medium">
      {connections.length} {connections.length === 1 ? 'Account' : 'Accounts'}
    </span>
  </div>

  {connections.length === 0 ? (
    <div class="p-6 rounded-xl bg-white/70 dark:bg-obsidian-card/60 border border-black/[0.06] dark:border-white/[0.08] text-center text-xs text-gray-500 dark:text-gray-400">
      No connected accounts configured yet.
    </div>
  ) : (
    <ul role="list" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 list-none p-0 m-0">
      {connections.map((conn) => (
        <li class="min-w-0">
          <a
            href={conn.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${conn.platform}: ${conn.handle} (opens in new tab)`}
            class="group flex items-center justify-between p-3.5 min-h-[52px] rounded-xl bg-white/70 dark:bg-obsidian-card/60 backdrop-blur-xl hover:bg-white/90 dark:hover:bg-obsidian-hover/75 active:scale-[0.985] active:bg-white/95 dark:active:bg-obsidian-hover/90 border border-black/[0.06] dark:border-white/[0.08] hover:border-black/[0.12] dark:hover:border-white/[0.18] shadow-sm transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blurple"
          >
            <div class="flex items-center gap-3 min-w-0">
              {/* Platform Icon */}
              <div class="w-8 h-8 rounded-lg bg-black/[0.04] dark:bg-white/[0.05] border border-black/[0.04] dark:border-white/[0.05] flex items-center justify-center text-gray-700 dark:text-gray-200 group-hover:text-blurple dark:group-hover:text-blurple-light transition-colors shrink-0">
                <Icons name={conn.icon} class="w-4 h-4" />
              </div>

              {/* Details */}
              <div class="min-w-0">
                <span class="text-xs font-semibold text-gray-800 dark:text-gray-200 truncate block">
                  {conn.platform}
                </span>
                <p class="text-xs text-gray-500 dark:text-gray-400 truncate">
                  {conn.handle}
                </p>
              </div>
            </div>

            {/* External Link Action Arrow */}
            <div class="text-gray-400 dark:text-gray-500 group-hover:text-blurple dark:group-hover:text-blurple-light group-hover:translate-x-0.5 transition-all shrink-0 pl-2">
              <Icons name="external-link" class="w-4 h-4" />
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</section>
