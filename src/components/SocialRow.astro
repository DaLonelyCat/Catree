---
import type { SocialIconItem } from '../config/profile';
import Icons from './Icons.astro';

interface Props {
  socials: SocialIconItem[];
}

const { socials } = Astro.props;
---

<div class="flex items-center justify-center flex-wrap gap-2.5 pt-2" aria-label="Social media profiles">
  {socials.map((item) => (
    <a
      href={item.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={item.label}
      class="w-11 h-11 rounded-xl bg-white/70 dark:bg-[#12141c]/60 backdrop-blur-xl hover:bg-white/90 dark:hover:bg-[#181b26]/75 border border-black/[0.06] dark:border-white/[0.08] hover:border-black/[0.12] dark:hover:border-white/[0.18] text-gray-700 dark:text-gray-300 hover:text-blurple dark:hover:text-blurple-light flex items-center justify-center shadow-sm transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blurple"
    >
      <Icons name={item.icon} class="w-5 h-5" />
    </a>
  ))}
</div>
