---
import type { ProfileConfig } from '../config/profile';
import Icons from './Icons.astro';

interface Props {
  discord: ProfileConfig['discord'];
}

const { discord } = Astro.props;
---

<div 
  id="discord-presence-card"
  class="w-full rounded-2xl bg-white dark:bg-discord-card border border-surface-border-light dark:border-discord-border p-5 shadow-sm transition-all duration-200"
  data-discord-id={discord.userId}
  data-enable-lanyard={discord.enableLanyard.toString()}
>
  {/* Header row */}
  <div class="flex items-center justify-between gap-3 pb-3 border-b border-surface-border-light dark:border-discord-border">
    <div class="flex items-center gap-2.5">
      <div class="p-1.5 rounded-lg bg-blurple/10 text-blurple">
        <Icons name="discord" class="w-5 h-5" />
      </div>
      <div>
        <h2 class="text-sm font-semibold tracking-wide uppercase text-gray-800 dark:text-gray-200">
          Discord Presence
        </h2>
        <p id="discord-status-text" class="text-xs text-gray-500 dark:text-discord-muted capitalize flex items-center gap-1.5">
          <span id="discord-indicator-dot" class="w-2 h-2 rounded-full bg-discord-online inline-block"></span>
          <span id="discord-status-label">{discord.fallbackStatus.status}</span>
        </p>
      </div>
    </div>

    {/* Live status badge */}
    <span 
      id="discord-live-pill"
      class="text-[11px] font-medium px-2.5 py-1 rounded-full bg-emerald-50 dark:bg-discord-online/15 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-discord-online/30 flex items-center gap-1.5"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
      Live
    </span>
  </div>

  {/* Dynamic Content Area: Custom status, Spotify, or Activity */}
  <div id="discord-dynamic-content" class="pt-3 space-y-3">
    {/* Custom Status Note */}
    <div id="discord-custom-status" class="text-xs sm:text-sm text-gray-700 dark:text-gray-300 flex items-center gap-2">
      <span class="text-base" id="discord-status-emoji">💬</span>
      <span id="discord-custom-status-text" class="italic">
        "{discord.fallbackStatus.customStatus || 'Active on Discord'}"
      </span>
    </div>

    {/* Spotify Widget Container (hidden by default until active) */}
    <div 
      id="discord-spotify" 
      class="hidden p-3 rounded-xl bg-emerald-50/50 dark:bg-[#122319] border border-emerald-200 dark:border-emerald-800/40 transition-all"
    >
      <div class="flex items-center gap-3">
        <img 
          id="spotify-album-art"
          src="" 
          alt="Album Art" 
          class="w-14 h-14 rounded-lg object-cover shadow-sm bg-black/10 shrink-0" 
        />
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-1.5 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">
            <Icons name="spotify" class="w-3.5 h-3.5" />
            <span>Listening to Spotify</span>
          </div>
          <p id="spotify-song" class="text-sm font-semibold text-gray-900 dark:text-white truncate">
            Song Title
          </p>
          <p id="spotify-artist" class="text-xs text-gray-600 dark:text-gray-300 truncate">
            by Artist
          </p>
        </div>
      </div>
      {/* Progress Bar */}
      <div class="mt-2.5 w-full bg-gray-200 dark:bg-gray-700 h-1 rounded-full overflow-hidden">
        <div id="spotify-progress" class="bg-emerald-500 h-full w-0 transition-all duration-1000"></div>
      </div>
    </div>

    {/* Gaming/Activity Widget Container (hidden by default until active) */}
    <div 
      id="discord-game-activity" 
      class="hidden p-3 rounded-xl bg-gray-50 dark:bg-discord-hover border border-surface-border-light dark:border-discord-border"
    >
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-blurple/20 text-blurple flex items-center justify-center shrink-0">
          <Icons name="gamepad" class="w-5 h-5" />
        </div>
        <div class="min-w-0 flex-1">
          <div class="text-[11px] font-semibold text-blurple uppercase tracking-wider">
            Playing a Game
          </div>
          <p id="activity-name" class="text-sm font-semibold text-gray-900 dark:text-white truncate">
            Game Name
          </p>
          <p id="activity-details" class="text-xs text-gray-600 dark:text-discord-muted truncate">
            In Match
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  interface LanyardSpotify {
    track_id: string;
    timestamps: { start: number; end: number };
    song: string;
    artist: string;
    album_art_url: string;
    album: string;
  }

  interface LanyardActivity {
    type: number;
    name: string;
    state?: string;
    details?: string;
    emoji?: { name: string; id?: string };
    assets?: {
      large_image?: string;
      large_text?: string;
    };
  }

  interface LanyardData {
    discord_user: {
      id: string;
      username: string;
      avatar: string;
      discriminator: string;
    };
    discord_status: 'online' | 'idle' | 'dnd' | 'offline';
    activities: LanyardActivity[];
    listening_to_spotify: boolean;
    spotify: LanyardSpotify | null;
  }

  const card = document.getElementById('discord-presence-card');
  const userId = card?.dataset.discordId;
  const enableLanyard = card?.dataset.enableLanyard === 'true';

  const statusColors: Record<string, string> = {
    online: '#23a55a',
    idle: '#f0b232',
    dnd: '#f23f43',
    offline: '#80848e',
  };

  function updateStatusUI(data: LanyardData) {
    const status = data.discord_status || 'offline';
    const statusLabel = document.getElementById('discord-status-label');
    const indicatorDot = document.getElementById('discord-indicator-dot');
    const avatarBadge = document.getElementById('discord-avatar-status');
    const customStatusEl = document.getElementById('discord-custom-status');
    const customStatusText = document.getElementById('discord-custom-status-text');
    const customStatusEmoji = document.getElementById('discord-status-emoji');

    if (statusLabel) statusLabel.textContent = status === 'dnd' ? 'Do Not Disturb' : status;
    if (indicatorDot) indicatorDot.style.backgroundColor = statusColors[status] || statusColors.offline;
    if (avatarBadge) avatarBadge.style.backgroundColor = statusColors[status] || statusColors.offline;

    // Update avatar if Discord avatar exists
    if (data.discord_user?.avatar) {
      const avatarEl = document.getElementById('discord-avatar') as HTMLImageElement;
      if (avatarEl) {
        avatarEl.src = `https://cdn.discordapp.com/avatars/${data.discord_user.id}/${data.discord_user.avatar}.png?size=256`;
      }
    }

    // Custom status (activity type 4)
    const customActivity = data.activities?.find(a => a.type === 4);
    if (customActivity && (customActivity.state || customActivity.emoji)) {
      if (customStatusEl) customStatusEl.classList.remove('hidden');
      if (customStatusText) customStatusText.textContent = customActivity.state ? `"${customActivity.state}"` : '';
      if (customStatusEmoji) customStatusEmoji.textContent = customActivity.emoji?.name || '💬';
    }

    // Spotify activity
    const spotifyWidget = document.getElementById('discord-spotify');
    if (data.listening_to_spotify && data.spotify) {
      if (spotifyWidget) spotifyWidget.classList.remove('hidden');
      const songEl = document.getElementById('spotify-song');
      const artistEl = document.getElementById('spotify-artist');
      const albumArt = document.getElementById('spotify-album-art') as HTMLImageElement;
      const progressBar = document.getElementById('spotify-progress');

      if (songEl) songEl.textContent = data.spotify.song;
      if (artistEl) artistEl.textContent = `by ${data.spotify.artist}`;
      if (albumArt) albumArt.src = data.spotify.album_art_url;

      if (progressBar && data.spotify.timestamps) {
        const total = data.spotify.timestamps.end - data.spotify.timestamps.start;
        const current = Date.now() - data.spotify.timestamps.start;
        const progress = Math.min(100, Math.max(0, (current / total) * 100));
        progressBar.style.width = `${progress}%`;
      }
    } else {
      if (spotifyWidget) spotifyWidget.classList.add('hidden');
    }

    // Other activity (Game)
    const gameActivity = data.activities?.find(a => a.type === 0);
    const gameWidget = document.getElementById('discord-game-activity');
    if (gameActivity) {
      if (gameWidget) gameWidget.classList.remove('hidden');
      const nameEl = document.getElementById('activity-name');
      const detailsEl = document.getElementById('activity-details');
      if (nameEl) nameEl.textContent = gameActivity.name;
      if (detailsEl) detailsEl.textContent = gameActivity.details || gameActivity.state || 'Active';
    } else {
      if (gameWidget) gameWidget.classList.add('hidden');
    }
  }

  // Connect to Lanyard via WebSocket for instant live updates
  if (enableLanyard && userId && userId !== '000000000000000000') {
    let socket: WebSocket | null = null;
    let heartbeatInterval: any = null;

    function connectWebSocket() {
      try {
        socket = new WebSocket('wss://api.lanyard.rest/socket');

        socket.onmessage = (event) => {
          const message = JSON.parse(event.data);

          if (message.op === 1) {
            // Hello packet, initialize heartbeat and subscribe
            heartbeatInterval = setInterval(() => {
              if (socket?.readyState === WebSocket.OPEN) {
                socket.send(JSON.stringify({ op: 3 }));
              }
            }, message.d.heartbeat_interval);

            socket.send(JSON.stringify({
              op: 2,
              d: {
                subscribe_to_id: userId,
              },
            }));
          } else if (message.op === 0) {
            // Dispatch event with live presence data
            if (message.t === 'INIT_STATE' || message.t === 'PRESENCE_UPDATE') {
              updateStatusUI(message.d);
            }
          }
        };

        socket.onclose = () => {
          clearInterval(heartbeatInterval);
          // Try reconnecting after 10 seconds
          setTimeout(connectWebSocket, 10000);
        };

        socket.onerror = () => {
          socket?.close();
        };
      } catch (e) {
        // Fallback to REST API if WebSocket fails
        fetchRestFallback();
      }
    }

    function fetchRestFallback() {
      fetch(`https://api.lanyard.rest/v1/users/${userId}`)
        .then(res => res.json())
        .then(data => {
          if (data.success && data.data) {
            updateStatusUI(data.data);
          }
        })
        .catch(() => {
          // Gracefully keep fallback status
        });
    }

    connectWebSocket();
  }
</script>
