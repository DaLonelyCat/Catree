---
import type { ProfileConfig } from '../config/profile';

interface Props {
  profile: ProfileConfig['profile'];
}

const { profile } = Astro.props;
---

<header class="relative w-full rounded-2xl overflow-hidden bg-white/70 dark:bg-[#12141c]/65 backdrop-blur-xl border border-black/[0.06] dark:border-white/[0.08] shadow-lg shadow-black/20 transition-all duration-200">
  {/* Banner backdrop */}
  <div 
    class="w-full h-36 sm:h-44 bg-cover bg-center relative"
    style={`background: ${profile.bannerGradient || '#5865f2'};`}
  >
    {profile.bannerImageUrl && (
      <img 
        src={profile.bannerImageUrl} 
        alt="Profile banner" 
        class="w-full h-full object-cover"
        loading="lazy"
      />
    )}
    <div class="absolute inset-0 bg-black/15"></div>
  </div>

  {/* Profile Info Row */}
  <div class="px-5 sm:px-7 pb-6 pt-0 relative">
    {/* Avatar offset */}
    <div class="flex flex-col sm:flex-row sm:items-end justify-between -mt-16 sm:-mt-20 gap-4 mb-4">
      <div class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-full p-1 bg-white dark:bg-[#12141c] border border-black/[0.08] dark:border-white/[0.1] shadow-md shrink-0">
        <img 
          id="discord-avatar"
          src={profile.avatarUrl} 
          alt={`${profile.name}'s avatar`}
          class="w-full h-full rounded-full object-cover bg-black"
          width="128"
          height="128"
        />
      </div>

      {/* Pronouns and location on the right */}
      <div class="flex flex-wrap items-center gap-2 self-start sm:self-end">
        {profile.pronouns && (
          <span class="px-3 py-1 rounded-full text-xs font-medium bg-black/[0.03] dark:bg-white/[0.05] text-gray-700 dark:text-gray-300 border border-black/[0.06] dark:border-white/[0.08]">
            {profile.pronouns}
          </span>
        )}
        {profile.location && (
          <span class="px-3 py-1 rounded-full text-xs font-medium bg-black/[0.03] dark:bg-white/[0.05] text-gray-700 dark:text-gray-300 border border-black/[0.06] dark:border-white/[0.08] flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-gray-400 dark:text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            {profile.location}
          </span>
        )}
      </div>
    </div>

    {/* Name and Handle */}
    <div class="space-y-1.5">
      <div class="flex items-center gap-2.5 flex-wrap">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
          {profile.name}
        </h1>
        <span class="text-sm font-semibold text-blurple bg-blurple/10 dark:bg-blurple/15 border border-blurple/20 px-2.5 py-0.5 rounded-lg">
          @{profile.handle}
        </span>
      </div>

      {/* Bio text */}
      <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 max-w-2xl leading-relaxed pt-0.5">
        {profile.bio}
      </p>
    </div>
  </div>
</header>
